# Environment variables for TubeCord.
# Copy this to .env and replace placeholder values with your deployment-specific settings.

# YouTube Configuration: required identifiers and credentials for the channel you want to monitor.
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Discord Configuration: supply one or more webhook URLs per content type; role IDs are optional.
# Multiple entries should be comma-separated so the service can notify several servers.

# Upload notifications: Discord destinations and roles for standard video uploads.
UPLOAD_WEBHOOK_URLS=https://discord.com/api/webhooks/your_upload_webhook_url_here
UPLOAD_ROLE_IDS=your_upload_role_id_here,another_upload_role_id

# Livestream notifications: Discord destinations and roles for livestream announcements.
LIVESTREAM_WEBHOOK_URLS=https://discord.com/api/webhooks/your_livestream_webhook_url_here
LIVESTREAM_ROLE_IDS=your_livestream_role_id_here,another_livestream_role_id

# Community post notifications (optional): requires yp-dl integration to scrape community posts.
COMMUNITY_WEBHOOK_URLS=https://discord.com/api/webhooks/your_community_webhook_url_here
COMMUNITY_ROLE_IDS=your_community_role_id_here,another_community_role_id

# Test destinations (optional but recommended): where the /test-* endpoints and
# the dashboard's Test buttons send. Point these at private test channels so
# test notifications never post to your public channels. If a type's test
# webhook is unset, that test returns an error instead of falling back to prod.
TEST_UPLOAD_WEBHOOK_URLS=
TEST_LIVESTREAM_WEBHOOK_URLS=
TEST_COMMUNITY_WEBHOOK_URLS=
# Optional role mentions for test posts (default: none, so tests don't ping).
TEST_UPLOAD_ROLE_IDS=
TEST_LIVESTREAM_ROLE_IDS=
TEST_COMMUNITY_ROLE_IDS=

# Community Post Monitoring Interval (optional): minutes between community post checks.
# Valid range: 1 to 1440. Defaults to 15 if unset or invalid.
COMMUNITY_CHECK_INTERVAL_MINUTES=15

# Database Configuration: SQLAlchemy connection string controlling where TubeCord stores state.
# Leave at the default SQLite path for quick starts, or point to an external database.
# Examples:
#   SQLite (default):          DATABASE_URL=sqlite:///data/community_posts.db
#   PostgreSQL:                DATABASE_URL=postgresql+psycopg://user:password@dbhost:5432/tubecord
#   MySQL or MariaDB:          DATABASE_URL=mysql+pymysql://user:password@dbhost:3306/tubecord
DATABASE_URL=sqlite:///data/community_posts.db
# Enable to log all SQL statements for troubleshooting.
DATABASE_ECHO=False

# WebSub Configuration: public-facing callback settings shared with YouTube's WebSub hub.
# HTTP or HTTPS both work; the callback just has to be reachable by the hub.
CALLBACK_URL=https://your-public-domain.example.com/webhook
# CALLBACK_PORT=443  # Override when exposing the webhook on a non-standard port

# Upload polling fallback: WebSub push periodically degrades on Google's side
# (Issue Tracker 554905105 — subscribe 503s, verification never arrives, uploads
# go missing). As a safety net, TubeCord polls the channel's recent uploads and
# delivers anything push missed, deduplicated so nothing is sent twice.
# Uses the YouTube Data API (needs YOUTUBE_API_KEY — the public RSS feed returns
# an empty placeholder to server-side requests and can't be relied on).
# UPLOAD_POLL_ENABLED=true               # set false to disable the fallback
# UPLOAD_CHECK_INTERVAL_MINUTES=15       # minutes between upload polls (1-1440)
# UPLOAD_MAX_AGE_HOURS=48                # only announce polled uploads newer than this
#                                        # (older ones are recorded silently, no backlog blast)

# WebSub resilience (optional): the hub is intermittently flaky, so a failed
# subscribe is retried with backoff and a watchdog keeps the subscription live.
# Defaults are sensible; override only if you know why.
# WEBSUB_LEASE_SECONDS=432000            # requested lease (YouTube caps at 5 days)
# WEBSUB_RENEWAL_LEAD_SECONDS=3600       # renew this long before the verified lease expires
# WEBSUB_SUBSCRIBE_MAX_RETRIES=8         # attempts per subscribe before giving up
# WEBSUB_SUBSCRIBE_RETRY_BASE_SECONDS=30 # initial backoff between retries
# WEBSUB_SUBSCRIBE_RETRY_MAX_SECONDS=900 # backoff cap
# WEBSUB_VERIFY_TIMEOUT_SECONDS=300      # treat an accepted-but-unverified subscribe as failed after this
# WEBSUB_WATCHDOG_INTERVAL_SECONDS=900   # how often the watchdog checks subscription health

# Flask Server Configuration: controls the local Flask/FastAPI server that handles incoming callbacks.
HOST=0.0.0.0
PORT=8000
DEBUG=False  # False keeps Flask/FastAPI in production mode (no auto-reload, minimal error pages); set to True only for local debugging

# Discord Message Format Configuration: toggle embed rendering for outgoing webhook payloads.
USE_RICH_EMBEDS=True  # Set to False for simple text messages instead of rich embeds

# Logging Configuration: choose the verbosity for application logs (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
